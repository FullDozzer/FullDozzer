# Telegram
BOT_TOKEN=YOUR_NEW_TOKEN
# Дополнительные premium/collectible usernames через запятую, без @.
# Основной username определяется автоматически через getMe.
BOT_USERNAME_ALIASES=mellowagent

# Платёжный токен BotFather -> Payments. Без него платная рассылка выключена.
PAYMENT_PROVIDER_TOKEN=
# Telegram ID модераторов через запятую. Модерация предшествует оплате.
ADMIN_IDS=
# ID custom emoji из набора, доступного боту. Пусто — обычный текст без emoji.
PREMIUM_EMOJI_ID=

# Совместимость со старой базой: группа для уже существующих подписчиков.
GROUP_NAME=ЭС7-24
GROUP_ID=508
BASE_URL=http://www.ishnk.ru/2025/site/schedule/group/508
STAFF_BASE_URL=http://www.ishnk.ru/2025/site/schedule/staff
GROUPS_URL=http://ishnk.ru/2025/json/groups
GROUP_CATALOG_TTL=21600

# Дни рождения (старое опциональное автопоздравление)
BIRTHDAY_URL=http://www.ishnk.ru/2025/site
BIRTHDAY_CHAT_ID=

# Проверка изменений и HTTP
CHECK_INTERVAL=300
HTTP_TIMEOUT=20
MONITOR_CONCURRENCY=4

# Rate limit
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WARNING_COOLDOWN=30

# Постоянные SQLite и PNG-кэш. Каталог нужно монтировать как Docker volume.
DATA_DIR=data
