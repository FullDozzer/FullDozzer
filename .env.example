# Telegram-токен бота. НЕ храни его в коде — только здесь / в окружении.
BOT_TOKEN=YOUR_NEW_TOKEN

# Группа расписания
GROUP_NAME=ЭС7-24
GROUP_ID=508
BASE_URL=http://www.ishnk.ru/2025/site/schedule/group/508

# Период автоматической проверки изменений (секунды). 5 минут = 300
CHECK_INTERVAL=300

# Таймаут HTTP-запроса к сайту (секунды)
HTTP_TIMEOUT=20

# Часовой пояс бота — фиксированный: Asia/Yekaterinburg (UTC+5).
# Он зашит в код (TIMEZONE = "Asia/Yekaterinburg") и НЕ читается из
# окружения, чтобы серверное время не влияло на даты.

# Дата/время релиза версии 2.1.4 в часовом поясе бота:
# формат "ГГГГ-ММ-ДД ЧЧ:ММ:СС" (например 2026-09-06 12:00:00).
# Заполняется явно в момент релиза. Пока поле пустое — changelog 2.1.4
# НЕ рассылается (в логах будет предупреждение).
CHANGELOG_2_1_4_RELEASED_AT=

# Каталог данных (база, изображения)
DATA_DIR=data
