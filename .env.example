# Telegram-токен бота. НЕ храни его в коде — только здесь / в окружении.
BOT_TOKEN=YOUR_NEW_TOKEN

# Группа расписания
GROUP_NAME=ЭС7-24
GROUP_ID=508
BASE_URL=http://www.ishnk.ru/2025/site/schedule/group/508

# Период автоматической проверки изменений (секунды). 30 минут = 1800
CHECK_INTERVAL=1800

# Таймаут HTTP-запроса к сайту (секунды)
HTTP_TIMEOUT=20

# Часовой пояс для дат «сегодня»/«завтра»
TIMEZONE=Europe/Moscow

# Каталог данных (база, изображения)
DATA_DIR=data
